{
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/fren?__p=:path*" }],
  "functions": { "api/fren.js": { "maxDuration": 60 } },
  "crons": [{ "path": "/api/cron", "schedule": "0 12 * * *" }],
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }]
}
